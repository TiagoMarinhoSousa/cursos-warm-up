{
    "compilerOptions": {
        "outDir": "app/dist/js",
        "target": "ES6",
        "noEmitOnError": true,
        "noImplicitAny": true,
        "removeComments": true,
        "strictNullChecks": true,
        "lib": ["DOM", "ESNext"],
        "types": [],
        "typeRoots": ["./node_modules/@types"],
        "experimentalDecorators": true
    },
    "include": ["app/src/**/*"]
}